# Copy to .env and fill in from Firebase console → Project settings → Your apps.
# These ship inside the client bundle (Vite inlines VITE_*), so they are config, not secrets;
# data access is enforced by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
