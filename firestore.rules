rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single-user app: each account can only touch its own subtree.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Friend lookup: one doc per verified email, keyed by that email. Readable one at a time by
    // signed-in users who already know the email; never listable. Only its owner can write it.
    match /directory/{email} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.token.email_verified == true
        && email == request.auth.token.email.lower()
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'photoURL'])
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Friends: one doc per pair, id = the two uids sorted and joined by "_". Only the two people can read it.
    // The sender creates it as pending; only the other person can accept it (and only change their own name);
    // either can delete it (decline, cancel, unfriend).
    match /friendships/{id} {
      function other(uid) {
        return resource.data.uids[0] == uid ? resource.data.uids[1] : resource.data.uids[0];
      }
      allow read: if request.auth != null && request.auth.uid in resource.data.uids;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uids', 'requester', 'status', 'names', 'createdAt', 'updatedAt'])
        && request.resource.data.uids.size() == 2
        && request.resource.data.uids[0] < request.resource.data.uids[1]
        && id == request.resource.data.uids[0] + '_' + request.resource.data.uids[1]
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null
        && request.auth.uid in resource.data.uids
        && request.auth.uid != resource.data.requester
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'names', 'updatedAt'])
        && request.resource.data.names[other(request.auth.uid)] == resource.data.names[other(request.auth.uid)];
      allow delete: if request.auth != null && request.auth.uid in resource.data.uids;
    }

    // Groups: members read them; any signed-in user with a valid invite can add only themselves.
    // The owner renames the group and manages its invite; members can leave; only the owner deletes.
    match /groups/{gid} {
      function isMember() {
        return request.auth.uid in resource.data.memberUids;
      }
      function nameOk() {
        return request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      }
      function onlyMemberChanged(uid) {
        return request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([uid]);
      }
      function inviteOk(token) {
        let inv = get(/databases/$(database)/documents/invites/$(token)).data;
        return inv.gid == gid && inv.revoked == false && inv.expiresAt > request.time.toMillis();
      }
      allow read: if request.auth != null && isMember();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'memberUids', 'members', 'inviteId', 'inviteExpiresAt', 'createdAt', 'updatedAt'])
        && nameOk()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);
      allow update: if request.auth != null && (
        // Owner: rename and manage the invite.
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'inviteId', 'inviteExpiresAt', 'updatedAt'])
          && nameOk())
        // Join: add only myself, with a working invite.
        || (!isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'updatedAt'])
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.memberUids.size() <= 30
          && onlyMemberChanged(request.auth.uid)
          && request.resource.data.members[request.auth.uid].keys().hasOnly(['displayName', 'photoURL', 'joinedAt', 'via'])
          && inviteOk(request.resource.data.members[request.auth.uid].via))
        // Leave: remove only myself (the owner deletes the group instead).
        || (isMember()
          && resource.data.ownerUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members', 'updatedAt'])
          && request.resource.data.memberUids == resource.data.memberUids.removeAll([request.auth.uid])
          && onlyMemberChanged(request.auth.uid)
          && !(request.auth.uid in request.resource.data.members))
        // Expenses: any member moves the running totals (only that and the timestamp).
        || (isMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totals', 'updatedAt'])
          && request.resource.data.totals is map)
      );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Group expenses: members read and add them; only the author edits (history is kept on the doc); the author or
    // the group's owner deletes. Everyone named in one must be a current member.
    match /groups/{gid}/expenses/{eid} {
      function group() {
        return get(/databases/$(database)/documents/groups/$(gid)).data;
      }
      function isMember() {
        return request.auth.uid in group().memberUids;
      }
      function valid() {
        let d = request.resource.data;
        return d.title is string && d.title.size() > 0 && d.title.size() <= 100
          && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.amount is int && d.amount > 0
          && d.paidBy in group().memberUids
          && d.shares is map && d.shares.size() > 0
          && d.shares.keys().hasOnly(group().memberUids)
          && d.createdBy is string && d.createdAt is int && d.updatedAt is int
          && (!('previous' in d) || (d.previous is list && d.previous.size() <= 10));
      }
      allow read: if request.auth != null && isMember();
      allow create: if request.auth != null && isMember() && valid()
        && request.resource.data.keys().hasOnly(['title', 'date', 'amount', 'paidBy', 'shares', 'createdBy', 'createdAt', 'updatedAt', 'previous'])
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null && isMember() && valid()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['title', 'date', 'amount', 'paidBy', 'shares', 'createdBy', 'createdAt', 'updatedAt', 'previous']);
      allow delete: if request.auth != null && isMember()
        && (resource.data.createdBy == request.auth.uid || group().ownerUid == request.auth.uid);
    }

    // Settle-up payments: a member records that they paid another member back (it counts in the balances at once).
    // Only the receiver confirms; the payer (undo) or the receiver (didn't get it) can remove it while it is pending.
    match /groups/{gid}/settlements/{sid} {
      function group() {
        return get(/databases/$(database)/documents/groups/$(gid)).data;
      }
      function isMember() {
        return request.auth.uid in group().memberUids;
      }
      allow read: if request.auth != null && isMember();
      allow create: if request.auth != null && isMember()
        && request.resource.data.keys().hasOnly(['from', 'to', 'amount', 'date', 'status', 'createdBy', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.to in group().memberUids
        && request.resource.data.to != request.resource.data.from
        && request.resource.data.amount is int && request.resource.data.amount > 0
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is int;
      // The receiver confirms it, or says they didn't get it ('rejected', kept so the payer is told).
      allow update: if request.auth != null && isMember()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && ((request.resource.data.status == 'confirmed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt']))
          || (request.resource.data.status == 'rejected'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectedAt'])));
      // While pending: the payer undoes it, or (older app versions) the receiver removes it. Once rejected: the payer
      // dismisses it.
      allow delete: if request.auth != null && isMember()
        && ((resource.data.status == 'pending' && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid))
          || (resource.data.status == 'rejected' && resource.data.from == request.auth.uid));
    }

    // Invite links: whoever holds the token (signed in) can read that one doc, to see what they are joining.
    // Only the group's owner can create, revoke or delete them.
    match /invites/{token} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['gid', 'groupName', 'ownerName', 'ownerUid', 'expiresAt', 'revoked', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.revoked == false
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.gid)).data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked', 'groupName']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Receipt links: anyone holding the (long, random) id can read that one doc, nobody can list them.
    // Only the owner can create, change or delete their own.
    match /shares/{id} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
