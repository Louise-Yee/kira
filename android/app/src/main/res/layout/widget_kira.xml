<?xml version="1.0" encoding="utf-8"?>
<!-- Bento tiles, mirroring Home: hero balance, In / Out cards, add. @android:id/background lets Android 12+
     animate the widget expanding into the app. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/widget_hero"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:layout_weight="6"
        android:background="@drawable/widget_tile_hero"
        android:clipToOutline="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_hero_texture" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:textColor="#D9FFFFFF" />

        <ImageView
                android:id="@+id/widget_left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/widget_totals"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_in_tile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In"
                android:textColor="#A1A1A1"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/widget_in"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_out_tile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_tile"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Out"
                android:textColor="#A1A1A1"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/widget_out"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_add"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:background="@drawable/widget_tile_add"
        android:contentDescription="Add transaction"
        android:foreground="?android:attr/selectableItemBackground">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/bricolage_extrabold"
            android:gravity="center"
            android:text="+"
            android:textColor="#0A1640"
            android:textSize="30sp" />
    </FrameLayout>
</LinearLayout>
